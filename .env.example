# Copy to .env.local and fill in. Never commit .env.local.
# Values come from the Supabase dashboard -> Project Settings -> API Keys.

# Project URL (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key, or the legacy "anon" key (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, or the legacy "service_role" key.
# SERVER ONLY: never prefix with NEXT_PUBLIC_, never paste into browser code.
SUPABASE_SECRET_KEY=

# Where this app runs; used in email confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
